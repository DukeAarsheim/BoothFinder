# Copy this file to .env.local and fill in the values.
# Names only here. Never commit real values: this repo is public.
# Ask Duke for the two public values. Duke sends them privately.

# Supabase project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (the newer "publishable" key also works). Public.
# Read-only: row-level security limits it to reading events and vendor lists.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY. It skips all database security.
# Only Duke and Vercel hold it. Leave empty locally unless Duke gives it to you;
# pages that only read events work without it.
SUPABASE_SERVICE_ROLE_KEY=

# Organizer AI assistant (/organizers). SERVER ONLY. Any OpenAI-compatible chat API works.
# Grok (xAI): AI_BASE_URL=https://api.x.ai/v1   OpenAI: AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL is a chat model name from that provider's docs. Without all three,
# the page still loads and shows "The AI assistant isn't set up yet."
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
