# Copy this file to .env.local and fill in the values.
# Names only here. Never commit real values: this repo is public.
# Ask Duke for the two public values. Duke sends them privately.

# Supabase project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (the newer "publishable" key also works). Public.
# Read-only: row-level security limits it to reading events and vendor lists.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY. It skips all database security.
# Only Duke and Vercel hold it. Leave empty locally unless Duke gives it to you;
# pages that only read events work without it.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox public access token (starts with "pk."). Public, but still keep it out of the repo.
# Read on the server and passed to the map; only "pk." tokens are used.
# Optional: without it the vendor map falls back to the free Leaflet/OpenStreetMap map.
# In the Mapbox dashboard, restrict the token to our URLs (localhost + the Vercel domain).
MAPBOX_TOKEN=

# --- Vendor-opportunity discovery (/admin/discovery). All SERVER ONLY. ---
# Without these the app still runs; the review page says what is missing.

# Shared team password for the review page and the discovery API routes.
# Pick any long random string. Without it, every discovery route refuses.
DISCOVERY_ADMIN_TOKEN=

# Vercel Cron sends this to run discovery daily (vercel.json). Any long random string.
CRON_SECRET=

# Web search for finding organizer pages. Tavily API key (https://tavily.com).
TAVILY_API_KEY=

# The AI that reads pages and PDFs. Any OpenAI-compatible chat API that supports JSON mode.
# OpenAI: AI_BASE_URL=https://api.openai.com/v1   Groq: https://api.groq.com/openai/v1
# AI_MODEL is a chat model name from that provider's docs.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
